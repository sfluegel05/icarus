# Copy to .env (same directory) and adjust. Everything is optional; the defaults
# are in icarus/config.py. Real environment variables take precedence over .env.

# ── Data ──
# ICARUS_DATA_DIR=/srv/icarus/data
# (ICARUS_HOST / ICARUS_PORT / ICARUS_PYTHON are read by run.sh before the app
#  starts, so set those in the real environment, not here.)

# ── Load limits (public deployments) ──
# ICARUS_MAX_TIMEOUT=300          # max ILP timeout a user may request (s)
# ICARUS_MAX_CONCURRENT_LEARNS=4  # simultaneous learning runs across all users

# ── LLM backend (only needed for the "LLM" learn method) ──
# ICARUS_LLM_MODEL=claude-haiku-5-5
# ICARUS_LLM_MODEL_NAME=Claude Haiku 5.5
# ICARUS_LLM_AUTH=api_key         # bill ANTHROPIC_API_KEY instead of a `claude` CLI login
# ANTHROPIC_API_KEY=sk-ant-...
# ICARUS_LLM_RATE_LIMIT=20        # prompts per window, all users together
# ICARUS_LLM_RATE_WINDOW=300      # window length (s)
# ICARUS_LLM_SESSION_LIMIT=10     # prompts per browser session (0 = unlimited)
# ICARUS_INVITE_CODES=code1,code2 # /?invite=<code> lifts both limits for that browser
# ICARUS_CONTACT=you@example.org  # shown when a user hits the session limit
